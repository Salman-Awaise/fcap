# Hugging Face token used to reach the GPT-OSS-20B router. Required.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Model endpoint and identifier. Defaults shown.
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=openai/gpt-oss-20b:fireworks-ai

# Where the SQLite database is written.
FCAP_DB_PATH=robust_gpt_oss_platform.db

# Server bind address.
FCAP_HOST=0.0.0.0
FCAP_PORT=8000
